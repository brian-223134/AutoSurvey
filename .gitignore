# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 데이터베이스 (OneDrive 배포본 또는 scripts/harvest_arxiv.py 산출물)
# database_2026-08/ 처럼 cutoff 날짜를 붙인 스냅샷 디렉터리도 모두 제외한다.
database/
database_*/
*.bin
*.h5
database.zip

# 생성 결과(output/)는 산출물이므로 의도적으로 추적한다.
# 단 *.bin / *.h5 규칙이 위에 있으니 output에 그런 파일을 두지 말 것.
#
# 예외: SurveyBench 채점용 ref.json 은 {topic}.json 에서 1초면 다시 만들어지는
# 파생물이다. 커밋해 두면 어느 산출물에서 나온 건지 흐려지므로 추적하지 않는다.
output/surveybench_ref/

# 로컬 설정 — API 키가 들어가므로 절대 커밋 금지
.env
*.local.sh

# LaTeX 빌드 산출물
*.aux
*.fls
*.fdb_latexmk
*.log
*.out
*.toc
*.synctex.gz

# 컴파일 산출물 PDF — .tex 에서 결정적으로 재생성된다 (README §6)
output/**/*.pdf
