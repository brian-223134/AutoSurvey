# ── .env.example ──────────────────────────────────────────────────────────
# 실제 설정 파일의 템플릿입니다. 아래 두 줄로 시작하세요.
#
#   cp .env.example .env
#   chmod 600 .env          # 키가 들어가므로 반드시
#
# 그다음 OPENROUTER_API_KEY 만 본인 값으로 바꾸면 됩니다. 나머지 값은
# 실제로 쓰고 있는 설정 그대로입니다.
#
# ⚠️ .env 는 .gitignore 에 있습니다. 이 파일(.env.example)만 커밋됩니다.
#    키를 여기에 적지 마세요.
#
# 사용법:  source .env  후 python main.py ...
#          main.py 는 --api_key 인자보다 이 환경변수를 쓰는 쪽이 안전합니다.
#          이 서버는 /proc 에 hidepid 가 없어 다른 사용자가 ps 로 명령줄을
#          읽을 수 있습니다.
#
# 변수는 두 종류입니다:
#   [코드]  src/model.py · main.py 가 os.environ 으로 직접 읽는 값
#   [셸]    코드는 모르는 값 — 실행 명령에서 "$변수" 로 참조해, CLI 인자와
#           .env 설정이 조용히 어긋나는 사고를 막는 용도
#           (예: python main.py --model "$AUTOSURVEY_MODEL" --api_url "$AUTOSURVEY_API_URL")

# ⚠️ 왜 커맨드라인(--api_key) 대신 환경변수인가
#    --api_key로 넘기면 실행되는 내내(본 실행은 수십 분~수 시간) 서버 사용자
#    전원에게 키가 노출됩니다. 반면 /proc/<pid>/environ은 소유자만 읽을 수 있습니다.


# ── LLM API ────────────────────────────────────────────────────────────────
# OpenRouter 키. https://openrouter.ai → Keys 에서 발급   [코드]
#
# ⚠️ 값 끝에 개행이나 공백이 들어가면 Authorization 헤더가 깨져 401이 납니다.
#    파일에 직접 써넣을 때는 따옴표 안쪽에 여분의 문자가 없는지 확인하세요.
export OPENROUTER_API_KEY=sk-or-v1-여기에-본인-키

# 참고: main.py / evaluation.py 는 --api_key 가 비어 있으면
#       OPENROUTER_API_KEY → AUTOSURVEY_API_KEY 순으로 환경변수를 찾습니다.
#       다른 공급자를 쓰신다면 AUTOSURVEY_API_KEY 를 쓰셔도 됩니다.

# 엔드포인트 [셸]. ⚠️ 끝의 /chat/completions 까지 붙여야 합니다 —
# src/model.py 는 경로를 덧붙이지 않고 --api_url 값을 그대로 사용합니다.
export AUTOSURVEY_API_URL=https://openrouter.ai/api/v1/chat/completions


# ── 백본 프로파일 ──────────────────────────────────────────────────────────
# 모델 id · provider 핀 · temperature · reasoning 은 **한 몸**입니다:
#
#   · provider tag 는 모델마다 다릅니다. main.py 의 사전 검사는 "그 tag 가 이
#     모델에 존재하는가"만 보므로, 이전 백본의 핀이 새 모델에도 우연히 존재하면
#     (예: llama-3.3-70b 에는 parasail/fp8 도 있음) **에러 없이 엉뚱한 provider**
#     로 나갑니다.
#   · 길이 계수·단가·추론 유무도 전부 모델 단위 실측값입니다.
#
# 그래서 값을 낱개로 고치지 말고 **블록째로** 활성/비활성을 바꾸세요.
# 새 백본은 블록을 하나 복사해 채우고, 스모크 1편으로 길이 계수를 잰 뒤 기입합니다.
#
# AUTOSURVEY_PROVIDER [코드]:
#   OpenRouter 는 같은 모델을 여러 provider 로 라우팅하는데 quantization 이
#   제각각이라, 고정하지 않으면 한 서베이 안에서 서브섹션마다 다른 정밀도가
#   씁니다. 값은 endpoint tag 그대로 — allow_fallbacks=false 가 함께 나가므로
#   붐벼도 다른 곳으로 넘어가지 않습니다. 비우면 자동 라우팅(원본 동작). 목록:
#     curl -s "https://openrouter.ai/api/v1/models/<model>/endpoints" \
#       | python -c "import json,sys; [print(e['tag'], e['quantization'], e['max_completion_tokens']) for e in json.load(sys.stdin)['data']['endpoints']]"
#
# AUTOSURVEY_TEMPERATURE [코드]:
#   에이전트 호출부는 temperature 가 하드코딩입니다(아웃라인·본문 1, judge 0).
#   값을 주면 **모든** 호출에 일괄 적용되고, 비우면 원본 동작 그대로입니다.
#   ⚠️ 0 이어도 재실행 시 동일 문구까지 보장되지는 않습니다(서빙 쪽 배칭 등
#      비결정성은 남음). '같은 설정으로 돌렸다'를 기록 가능하게 하는 것이 목적.
#
# AUTOSURVEY_REASONING [코드]:
#   off = {"reasoning":{"enabled":false}} 를 페이로드에 추가. 비우면 필드 자체를
#   보내지 않습니다. 비추론 모델은 비워 두는 쪽이 원본 페이로드와 같습니다.

## ▶ 활성: meta-llama/llama-3.3-70b-instruct (2026-08-31 ~)
export AUTOSURVEY_MODEL=meta-llama/llama-3.3-70b-instruct
export AUTOSURVEY_PROVIDER=akashml/fp8    # fp8 / max_out 128K / $0.20·$0.52 per M (2026-08-31 확인)
export AUTOSURVEY_TEMPERATURE=0           # 결정론 실험 계열 — 전 호출 0
export AUTOSURVEY_REASONING=              # 비추론 모델 — 필드 미전송
# 길이 계수: 1.21× 실측 (2026-08-31 Edge Computing 본편 — 지시 520 → 서브당 632단어.
#            단 subsection_num 4 상한을 다 안 채우고 섹션당 평균 3.1개만 씀:
#            개수 미달을 감안해 subsection_len 을 잡을 것. docs/commoncorpus-setup.md §6)

## 이전: deepseek/deepseek-v4-flash-0731 (2026-08-05 ~ 08-18, 산출물 5편)
# export AUTOSURVEY_MODEL=deepseek/deepseek-v4-flash-0731
# export AUTOSURVEY_PROVIDER=parasail/fp8
# export AUTOSURVEY_TEMPERATURE=          # 당시 코드 고정 1 (오버라이드 도입 전)
# export AUTOSURVEY_REASONING=off         # 추론이 기본 ON 인 계열. v4-pro 실측 —
#                                         # OFF: 비용 36%↓, 31% 빠름, 본문은 오히려 소폭 김
# 길이 계수: 1.76× (스모크 1.73 / 본편 1.79 평균)

## 이전: anthropic/claude-3-haiku (논문의 writer 모델)
# export AUTOSURVEY_MODEL=anthropic/claude-3-haiku
# export AUTOSURVEY_PROVIDER=             # 엔드포인트가 amazon-bedrock 하나뿐 — 핀 불필요
# export AUTOSURVEY_TEMPERATURE=
# export AUTOSURVEY_REASONING=            # 비추론 모델
# 길이 계수: 0.77×


# ── HTTP 타임아웃(초) [코드] ──────────────────────────────────────────────
# 추론 모델은 호출당 1분을 넘기므로 원본 기본값 300은 짧습니다.
# 타임아웃은 재시도를 부르고, 재시도는 프롬프트 전체를 다시 청구시킵니다.
export AUTOSURVEY_TIMEOUT=900


# ── 동시성 [코드] ──────────────────────────────────────────────────────────
# src/model.py 의 batch_chat 이 띄우는 스레드 상한 (기본 15).
#
# ⚠️ 실제 동시 요청 수는 section_num 이 곱해집니다.
#    기본값 그대로면 8섹션 × 15 = 120개가 한꺼번에 나가 429를 맞습니다.
#    낮게 잡고 시작하는 편이 안전하고, 재시도가 줄어 비용에도 유리합니다.
export AUTOSURVEY_MAX_THREADS=4

# 재시도 한도 (기본 8). 429 가 잦으면 스레드를 낮추는 것이 먼저고,
# 그래도 소진되면 올리세요.   [코드]
# export AUTOSURVEY_MAX_RETRY=10


# ── GPU ────────────────────────────────────────────────────────────────────
# GPU를 쓰는 곳은 nomic 임베딩뿐이라 1장이면 충분합니다. (공용 서버 배려)
# main.py 의 --gpu 인자는 어디에서도 사용되지 않으니 이 변수로 지정하세요.
#
# ⚠️ 공용 서버라 0번이 남의 작업으로 차 있을 때가 있습니다. 아래는 **이미 값이
#    설정돼 있으면 그것을 존중**합니다. 빈 GPU 를 고르려면 source 전에 지정하세요:
#      export CUDA_VISIBLE_DEVICES=$(nvidia-smi --query-gpu=index,memory.used \
#        --format=csv,noheader,nounits | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' ')
#      source .env
export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0}

# 임베딩을 CPU에서 돌리려면 아래 주석을 해제하세요 (auto | cuda | cpu | mps)
# export AUTOSURVEY_DEVICE=cpu


# ── 임베딩 · DB ───────────────────────────────────────────────────────────
# 임베딩 모델 [셸]. 인덱스를 만든 모델과 검색 모델(main.py --embedding_model)은
# **반드시 같아야** 합니다. v1.5 등으로 바꾸면 에러 없이 검색 품질만 무너집니다.
export AUTOSURVEY_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1

# DB 는 실험 축이라 .env 에 고정하지 않습니다. 실행 명령에서 고르세요:
#   --db_path ./database                    배포본       537,665편 (~2024-04-26)
#   --db_path ./database_2026-08            최신화본     909,293편 (~2026-08-03)
#                                           (배포본의 상위 집합 — 둘은 대체 관계)
#   --db_path ./database_commoncorpus-2512  Common Corpus 예시 view 947,463편
#             (cutoff 2025-12-31, ../asg-common-corpus 반출본. id 는 버전 접미사
#              없는 base id. 기존 스냅샷들과 corpus 가 달라 **비교 축을 분리**할 것.
#              run 기록에 동봉 manifest 의 content_sha256 을 남기세요)
#   ⚠️ 인자를 빼면 배포본으로 조용히 떨어집니다. 새 실험은 DB 를 명시하세요.


# ── 실행 파라미터 (참고용, main.py 인자로 넘기는 값) ──────────────────────
# 논문 설정 : --section_num 8 --subsection_len 700 --rag_num 60 --outline_reference_num 1200
# 첫 스모크 : --section_num 4 --outline_reference_num 200 --rag_num 15
#
# 분량 통제 : --subsection_num N  (섹션당 서브섹션 상한. 0=원본 동작)
#            총 분량 = section_num × subsection_num × (subsection_len × 모델 계수)
#            ⚠️ subsection_len 은 상한이 아니라 **하한**("more than N words")이라
#               모델마다 실제 분량이 크게 다릅니다. 계수는 위 백본 프로파일에 기록.
#            새 백본은 스모크 1편으로 계수를 재고 목표를 그 계수로 나눠 넣으세요:
#               python scripts/check_survey.py <md> --subsection-len=700 --target-words=20000
